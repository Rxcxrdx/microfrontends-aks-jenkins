#!/bin/bash
# Copia este archivo a env.sh y rellena con tu propio Service Principal de Azure.
# env.sh esta en .gitignore — nunca lo subas.
#
# Para crear el Service Principal:
#   az ad sp create-for-rbac --name sp-terraform-lab --role Contributor \
#     --scopes /subscriptions/<TU_SUBSCRIPTION_ID>

export ARM_CLIENT_ID="00000000-0000-0000-0000-000000000000"
export ARM_CLIENT_SECRET="<el password que devuelve el comando de arriba>"
export ARM_TENANT_ID="00000000-0000-0000-0000-000000000000"
export ARM_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
